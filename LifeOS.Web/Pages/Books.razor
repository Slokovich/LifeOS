@* Books.razor — pagina "Libri": mostra i libri salvati nel database e permette di aggiungerne.
   I dati arrivano dall'API (GET /api/books) e vengono inviati all'API (POST /api/books,
   e POST /api/books/import per il CSV di Goodreads):
   il frontend non tocca mai il database direttamente (CLAUDE.md §6). *@

@* @page "/books" = questa pagina si apre all'indirizzo /books. *@
@page "/books"
@using LifeOS.Web.Models
@* @inject = chiede a Blazor l'HttpClient registrato in Program.cs (già puntato all'API). *@
@inject HttpClient Http

<PageTitle>Libri</PageTitle>

<h1>Libri</h1>

@* ─── Modulo per aggiungere un libro ─── *@
<div class="row g-2 mb-4">
    <div class="col-md-4">
        @* @bind = collega il campo alla variabile C#: quello che scrivi finisce in newTitle. *@
        <input class="form-control" placeholder="Titolo" @bind="newTitle" />
    </div>
    <div class="col-md-3">
        <input class="form-control" placeholder="Autore" @bind="newAuthor" />
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="newStatus">
            @* value = ciò che viene inviato all'API (parole dell'enum); il testo è quello mostrato. *@
            <option value="ToRead">Da leggere</option>
            <option value="Reading">In lettura</option>
            <option value="Read">Letto</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100" @onclick="AddBookAsync">Aggiungi</button>
    </div>
</div>

@* ─── Import del CSV di Goodreads ─── *@
<div class="mb-4">
    <label class="form-label">Importa da Goodreads (file .csv esportato dal sito)</label>
    @* InputFile = componente di Blazor che apre la scelta del file; OnChange parte appena ne scegli uno. *@
    <InputFile class="form-control" accept=".csv" OnChange="ImportCsvAsync" disabled="@importing" />
    @if (importing)
    {
        <div class="form-text">Importazione in corso...</div>
    }
    @if (importResult is not null)
    {
        <div class="alert alert-success mt-2">
            Import completato: @importResult.Added aggiunti, @importResult.Updated aggiornati,
            @importResult.Skipped saltati.
        </div>
    }
</div>

@* ─── Import del CSV di un'altra persona (es. Fra, per la sfida competitiva) ─── *@
<div class="mb-4">
    <label class="form-label">Importa il CSV di Goodreads di un'altra persona</label>
    <div class="row g-2">
        <div class="col-sm-3">
            <input class="form-control" placeholder="Nome" @bind="readerName" disabled="@importing" />
        </div>
        <div class="col-sm-9">
            <InputFile class="form-control" accept=".csv" OnChange="ImportReaderCsvAsync" disabled="@(importing || string.IsNullOrWhiteSpace(readerName))" />
        </div>
    </div>
    @if (readerImportResult is not null)
    {
        <div class="alert alert-success mt-2">
            Libri di @readerName: @readerImportResult.Added aggiunti, @readerImportResult.Updated aggiornati,
            @readerImportResult.Skipped saltati.
        </div>
    }
</div>

@* Messaggio d'errore (visibile solo se c'è un errore). *@
@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@* ─── Elenco dei libri ─── *@
@if (books is null)
{
    @* books è null finché i dati non sono arrivati dall'API. *@
    <p><em>Caricamento...</em></p>
}
else if (books.Count == 0)
{
    <p>Nessun libro salvato: aggiungine uno qui sopra.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Titolo</th><th>Autore</th><th>Stato</th></tr>
        </thead>
        <tbody>
            @foreach (var book in books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@StatusLabel(book.Status)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    // Elenco dei libri ricevuti dall'API (null = non ancora caricato).
    private List<BookItem>? books;

    // Valori dei campi del modulo.
    private string newTitle = "";
    private string newAuthor = "";
    private string newStatus = "ToRead";

    // Testo dell'ultimo errore, da mostrare all'utente (null = nessun errore).
    private string? error;

    // Parte automaticamente quando la pagina si apre: carica i libri.
    protected override async Task OnInitializedAsync() => await LoadBooksAsync();

    // Chiede l'elenco all'API (GET /api/books). L'indirizzo base arriva da wwwroot/appsettings.json.
    private async Task LoadBooksAsync()
    {
        try
        {
            books = await Http.GetFromJsonAsync<List<BookItem>>("api/books");
            error = null;
        }
        catch (HttpRequestException)
        {
            // Succede se l'API non è avviata o il CORS blocca la richiesta.
            error = "Impossibile contattare l'API. È avviata (dotnet run --project LifeOS.Api)?";
            books = [];
        }
    }

    // Invia il nuovo libro all'API (POST /api/books) e poi ricarica l'elenco.
    private async Task AddBookAsync()
    {
        // Controllo veloce lato browser; l'API ripete comunque i controlli.
        if (string.IsNullOrWhiteSpace(newTitle) || string.IsNullOrWhiteSpace(newAuthor))
        {
            error = "Titolo e autore sono obbligatori.";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/books",
                new BookItem { Title = newTitle, Author = newAuthor, Status = newStatus });
            response.EnsureSuccessStatusCode(); // lancia un errore se l'API ha risposto "no"

            // Libro salvato: svuota il modulo e ricarica l'elenco.
            newTitle = "";
            newAuthor = "";
            await LoadBooksAsync();
        }
        catch (HttpRequestException)
        {
            error = "Salvataggio non riuscito. L'API è avviata?";
        }
    }

    // Dimensione massima accettata per il CSV (Blazor di default si ferma a 500 KB): 10 MB.
    private const long MaxCsvBytes = 10 * 1024 * 1024;

    // Riepilogo dell'ultimo import (null = nessun import fatto) e flag "import in corso".
    private ImportResultItem? importResult;
    private bool importing;

    // Nome della persona per l'import del suo CSV e riepilogo del suo ultimo import.
    private string readerName = "Fra";
    private ImportResultItem? readerImportResult;

    // Parte quando scegli il TUO file: lo invia all'API (POST /api/books/import) e ricarica l'elenco.
    private async Task ImportCsvAsync(InputFileChangeEventArgs e)
    {
        importResult = await UploadCsvAsync(e, "api/books/import");
        if (importResult is not null) await LoadBooksAsync(); // mostra subito i libri importati
    }

    // Parte quando scegli il file di un'ALTRA persona: POST /api/readers/{nome}/import.
    // I suoi libri non compaiono nell'elenco qui sotto (che mostra solo i tuoi).
    private async Task ImportReaderCsvAsync(InputFileChangeEventArgs e) =>
        readerImportResult = await UploadCsvAsync(e, $"api/readers/{Uri.EscapeDataString(readerName.Trim())}/import");

    // Invia il CSV all'indirizzo indicato e restituisce il riepilogo (null se qualcosa è andato storto).
    private async Task<ImportResultItem?> UploadCsvAsync(InputFileChangeEventArgs e, string url)
    {
        importing = true;
        importResult = null;
        readerImportResult = null;
        error = null;
        try
        {
            // Un modulo "multipart/form-data" con il file nel campo "file" (il nome atteso dall'API).
            using var content = new MultipartFormDataContent();
            using var stream = e.File.OpenReadStream(MaxCsvBytes);
            content.Add(new StreamContent(stream), "file", e.File.Name);

            var response = await Http.PostAsync(url, content);
            if (!response.IsSuccessStatusCode)
            {
                // L'API spiega il motivo nel corpo della risposta (es. "Il file è vuoto.").
                error = $"Import non riuscito: {await response.Content.ReadAsStringAsync()}";
                return null;
            }

            return await response.Content.ReadFromJsonAsync<ImportResultItem>();
        }
        catch (HttpRequestException)
        {
            error = "Import non riuscito. L'API è avviata?";
        }
        catch (IOException)
        {
            // Succede se il file supera MaxCsvBytes.
            error = "File troppo grande (massimo 10 MB).";
        }
        finally
        {
            importing = false;
        }
        return null; // si arriva qui solo dopo un errore
    }

    // Traduce il valore dell'enum (inglese) nel testo italiano mostrato all'utente.
    private static string StatusLabel(string status) => status switch
    {
        "ToRead" => "Da leggere",
        "Reading" => "In lettura",
        "Read" => "Letto",
        _ => status
    };
}
